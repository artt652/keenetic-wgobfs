diff --git a/src/wgobfs.c b/src/wgobfs.c
new file mode 100644
index 0000000..37dbd61
--- /dev/null
+++ b/src/wgobfs.c
@@ -0,0 +1,290 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Client side of the wg-obfuscator wire protocol. See wgobfs.h.
+ *
+ * Wire format of an obfuscated packet (obfuscation version 1):
+ *   - take the WireGuard message M (type in the first byte, bytes 1..3 are
+ *     zero in WireGuard);
+ *   - pick r in 1..255: byte0 ^= r, byte1 = r;
+ *   - if |M| < 1024: pick a padding length d (handshake init/response: below
+ *     min(1024-|M|, 512); cookie/data: below min(1024-|M|, max_dummy)),
+ *     store d little-endian in bytes 2..3, append d bytes of 0xFF;
+ *   - XOR the whole packet with a keystream: s = 0; for each byte i,
+ *     s = crc8(s, key[i % klen] + (total_len & 0xFF) + klen) with the
+ *     reflected polynomial 0x8C, output byte i ^= s.
+ * STUN masking wraps that in a STUN Data Indication (type 0x0115, magic
+ * cookie, random transaction id, DATA attribute 0x0013).
+ */
+
+#include "wgobfs.h"
+
+#include <linux/kernel.h>
+#include <linux/skbuff.h>
+#include <linux/string.h>
+#include <linux/ctype.h>
+#include <linux/random.h>
+#include <linux/crc32.h>
+#include <linux/netdevice.h>
+#include <asm/unaligned.h>
+
+#define WG_TYPE_MIN 1
+#define WG_TYPE_MAX 4
+#define WG_TYPE_HANDSHAKE_INIT 1
+#define WG_TYPE_HANDSHAKE_RESP 2
+
+#define STUN_COOKIE 0x2112A442U
+#define STUN_DATA_INDICATION 0x0115
+#define STUN_BINDING_REQUEST 0x0001
+#define STUN_ATTR_DATA 0x0013
+#define STUN_ATTR_FINGERPRINT 0x8028
+#define STUN_FINGERPRINT_XOR 0x5354554eU
+
+static u8 crc_state_tab[256];	/* one CRC8 step of the state, input 0 */
+static u8 crc_input_tab[256];	/* one CRC8 step of the input, state 0 */
+static bool crc_ready;
+
+static u8 crc8_bits(u8 crc, u8 in)
+{
+	int bit;
+
+	for (bit = 0; bit < 8; ++bit) {
+		u8 lsb = (crc ^ in) & 1;
+
+		crc >>= 1;
+		if (lsb)
+			crc ^= 0x8C;
+		in >>= 1;
+	}
+	return crc;
+}
+
+static void crc_init(void)
+{
+	int i;
+
+	if (likely(READ_ONCE(crc_ready)))
+		return;
+	/* CRC8 with this polynomial is linear: step(s, x) = step(s, 0) ^ step(0, x). */
+	for (i = 0; i < 256; ++i) {
+		crc_state_tab[i] = crc8_bits((u8)i, 0);
+		crc_input_tab[i] = crc8_bits(0, (u8)i);
+	}
+	smp_wmb();
+	WRITE_ONCE(crc_ready, true);
+}
+
+static void keystream_xor(const struct wgobfs_cfg *cfg, u8 *data,
+			  unsigned int len)
+{
+	const u8 mix = (u8)(len + cfg->key_len);
+	unsigned int i, k = 0;
+	u8 s = 0;
+
+	crc_init();
+	for (i = 0; i < len; ++i) {
+		s = crc_state_tab[s] ^ crc_input_tab[(u8)(cfg->key[k] + mix)];
+		data[i] ^= s;
+		if (++k == cfg->key_len)
+			k = 0;
+	}
+}
+
+static inline bool is_wg_type(const u8 *data)
+{
+	u32 type = get_unaligned_le32(data);
+
+	return type >= WG_TYPE_MIN && type <= WG_TYPE_MAX;
+}
+
+static int hexval(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	c = tolower(c);
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	return -1;
+}
+
+int wgobfs_parse_spec(const char *spec, struct wgobfs_cfg *cfg)
+{
+	static const char prefix[] = "<b 0x57474f42";
+	u8 raw[4 + WGOBFS_KEY_MAX + 1];
+	size_t n = 0, plen = sizeof(prefix) - 1;
+	const char *p;
+
+	if (!spec)
+		return 0;
+	while (isspace(*spec))
+		++spec;
+	if (strncasecmp(spec, prefix, plen))
+		return 0;
+	/* Hex digits after the magic, up to '>'. */
+	for (p = spec + plen; *p && *p != '>'; p += 2) {
+		int hi = hexval(p[0]), lo = p[1] ? hexval(p[1]) : -1;
+
+		if (hi < 0 || lo < 0 || n >= sizeof(raw))
+			return -EINVAL;
+		raw[n++] = (u8)(hi << 4 | lo);
+	}
+	if (*p != '>')
+		return -EINVAL;
+	/* version, masking, max_dummy(2), key(>=1) */
+	if (n < 5 || raw[0] != 1 || raw[1] > WGOBFS_MASKING_STUN)
+		return -EINVAL;
+	memset(cfg, 0, sizeof(*cfg));
+	cfg->masking = raw[1];
+	cfg->max_dummy = min_t(u16, get_unaligned_be16(raw + 2), WGOBFS_MAX_TOTAL);
+	cfg->key_len = n - 4;
+	if (cfg->key_len > WGOBFS_KEY_MAX)
+		return -EINVAL;
+	memcpy(cfg->key, raw + 4, cfg->key_len);
+	return 1;
+}
+
+static u16 pick_dummy(const struct wgobfs_cfg *cfg, u8 type, unsigned int len)
+{
+	unsigned int room, limit;
+
+	if (len >= WGOBFS_MAX_TOTAL)
+		return 0;
+	room = WGOBFS_MAX_TOTAL - len;
+	if (type == WG_TYPE_HANDSHAKE_INIT || type == WG_TYPE_HANDSHAKE_RESP)
+		limit = min_t(unsigned int, room, WGOBFS_MAX_DUMMY_HANDSHAKE);
+	else
+		limit = min_t(unsigned int, room, cfg->max_dummy);
+	return limit ? (u16)prandom_u32_max(limit) : 0;
+}
+
+static void stun_header(u8 *h, u16 type, u16 msg_len)
+{
+	put_unaligned_be16(type, h);
+	put_unaligned_be16(msg_len, h + 2);
+	put_unaligned_be32(STUN_COOKIE, h + 4);
+	get_random_bytes(h + 8, 12);
+}
+
+int wgobfs_encode_skb(const struct wgobfs_cfg *cfg, struct sk_buff *skb)
+{
+	unsigned int len, need_tail, head_extra;
+	u16 dummy = 0;
+	u8 *data, type, r;
+	int ret;
+
+	if (unlikely(skb_linearize(skb)))
+		return -ENOMEM;
+	len = skb->len;
+	if (unlikely(len < 4 || len > U16_MAX - WGOBFS_STUN_OVERHEAD))
+		return -EINVAL;
+
+	type = skb->data[0];
+	if (len < WGOBFS_MAX_TOTAL)
+		dummy = pick_dummy(cfg, type, len);
+
+	/* Room for the padding at the tail and the STUN header at the head,
+	 * on top of what the UDP/IP output path will push later.
+	 */
+	need_tail = dummy;
+	head_extra = cfg->masking == WGOBFS_MASKING_STUN ? WGOBFS_STUN_OVERHEAD : 0;
+	if (skb_cloned(skb) || skb_tailroom(skb) < need_tail ||
+	    skb_headroom(skb) < head_extra + LL_MAX_HEADER + 48 + 8) {
+		int dh = (int)(head_extra + LL_MAX_HEADER + 48 + 8) - (int)skb_headroom(skb);
+		int dt = (int)need_tail - (int)skb_tailroom(skb);
+
+		ret = pskb_expand_head(skb, dh > 0 ? ALIGN(dh, NET_SKB_PAD) : 0,
+				       dt > 0 ? dt : 0, GFP_ATOMIC);
+		if (unlikely(ret))
+			return ret;
+	}
+
+	data = skb->data;
+	r = 1 + (u8)prandom_u32_max(255);
+	data[0] ^= r;
+	data[1] = r;
+	if (len < WGOBFS_MAX_TOTAL) {
+		put_unaligned_le16(dummy, data + 2);
+		if (dummy)
+			memset(skb_put(skb, dummy), 0xFF, dummy);
+	}
+	keystream_xor(cfg, skb->data, skb->len);
+
+	if (cfg->masking == WGOBFS_MASKING_STUN) {
+		u16 payload = skb->len;
+		u8 *h = skb_push(skb, WGOBFS_STUN_OVERHEAD);
+
+		/* The message length stays 0, as wg-obfuscator sends it. */
+		stun_header(h, STUN_DATA_INDICATION, 0);
+		put_unaligned_be16(STUN_ATTR_DATA, h + 20);
+		put_unaligned_be16(payload, h + 22);
+	}
+	return 0;
+}
+
+int wgobfs_decode_skb(const struct wgobfs_cfg *cfg, struct sk_buff *skb)
+{
+	unsigned int len;
+	u8 *data;
+
+	if (unlikely(skb_linearize(skb)))
+		return -ENOMEM;
+	if (unlikely(skb_cloned(skb) && pskb_expand_head(skb, 0, 0, GFP_ATOMIC)))
+		return -ENOMEM;
+	if (skb->len < 4)
+		return -EINVAL;
+
+	/* STUN: unwrap Data Indications, drop everything else (Binding
+	 * requests/responses are keepalives of the masking layer).
+	 */
+	if (skb->len >= 8 && get_unaligned_be32(skb->data + 4) == STUN_COOKIE) {
+		unsigned int msg_len, dlen;
+
+		if (skb->len < WGOBFS_STUN_OVERHEAD ||
+		    get_unaligned_be16(skb->data) != STUN_DATA_INDICATION)
+			return -EPROTO;
+		msg_len = get_unaligned_be16(skb->data + 2);
+		dlen = get_unaligned_be16(skb->data + 22);
+		if (msg_len + 20 > skb->len ||
+		    get_unaligned_be16(skb->data + 20) != STUN_ATTR_DATA ||
+		    dlen + WGOBFS_STUN_OVERHEAD > skb->len)
+			return -EINVAL;
+		__skb_pull(skb, WGOBFS_STUN_OVERHEAD);
+		if (pskb_trim(skb, dlen))
+			return -ENOMEM;
+		if (skb->len < 4)
+			return -EINVAL;
+	}
+
+	data = skb->data;
+	len = skb->len;
+	keystream_xor(cfg, data, len);
+	if (!is_wg_type(data)) {
+		u16 dummy;
+
+		data[0] ^= data[1];
+		dummy = get_unaligned_le16(data + 2);
+		if (dummy > len - 4)
+			return -EINVAL;
+		len -= dummy;
+		data[1] = data[2] = data[3] = 0;
+		if (!is_wg_type(data))
+			return -EINVAL;
+		if (pskb_trim(skb, len))
+			return -ENOMEM;
+	}
+	/* else: version 0 peer (XOR only), the message is already plain. */
+	return 0;
+}
+
+int wgobfs_stun_binding_request(u8 *buf)
+{
+	u32 fp;
+
+	stun_header(buf, STUN_BINDING_REQUEST, 0);
+	put_unaligned_be16(STUN_ATTR_FINGERPRINT, buf + 20);
+	put_unaligned_be16(4, buf + 22);
+	/* FINGERPRINT covers the message up to the attribute (RFC 5389). */
+	fp = crc32_le(~0U, buf, 20) ^ ~0U;
+	put_unaligned_be32(fp ^ STUN_FINGERPRINT_XOR, buf + 24);
+	put_unaligned_be16(8, buf + 2);
+	return 28;
+}
diff --git a/src/wgobfs.h b/src/wgobfs.h
new file mode 100644
index 0000000..8111ef5
--- /dev/null
+++ b/src/wgobfs.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0
+ *
+ * Client side of the wg-obfuscator wire protocol (ClusterM/wg-obfuscator,
+ * obfuscation version 1, optional STUN masking), so this module can talk to a
+ * wg-obfuscator server directly.
+ *
+ * Independent implementation written from the protocol description; no code
+ * of wg-obfuscator is used.
+ *
+ * Enabled through the AmneziaWG I5 parameter (see wgobfs_parse_spec()):
+ *   <b 0x57474F42 VV MM DDDD KK..>
+ *   57474F42 "WGOB" magic, VV format version (01), MM masking (00 none,
+ *   01 STUN), DDDD max dummy bytes for data packets (big-endian), KK.. key.
+ */
+
+#ifndef _WG_WGOBFS_H
+#define _WG_WGOBFS_H
+
+#include <linux/types.h>
+#include <linux/rcupdate.h>
+
+struct sk_buff;
+
+#define WGOBFS_KEY_MAX 255
+#define WGOBFS_STUN_OVERHEAD 24	/* STUN header + DATA attribute header */
+#define WGOBFS_MAX_TOTAL 1024	/* packets are padded up to this size at most */
+#define WGOBFS_MAX_DUMMY_HANDSHAKE 512
+
+enum wgobfs_masking {
+	WGOBFS_MASKING_NONE = 0,
+	WGOBFS_MASKING_STUN = 1,
+};
+
+struct wgobfs_cfg {
+	struct rcu_head rcu;
+	u8 masking;
+	u16 max_dummy;
+	u16 key_len;
+	u8 key[WGOBFS_KEY_MAX];
+};
+
+/* Returns 1 and fills @cfg when @spec is a WGOB I5 value, 0 when it is
+ * something else (a regular I5 junk spec), or a negative error when it has
+ * the magic but is malformed.
+ */
+int wgobfs_parse_spec(const char *spec, struct wgobfs_cfg *cfg);
+
+/* Obfuscates the WireGuard message in @skb in place (skb->data is the start
+ * of the message). May reallocate the skb head. Returns 0 or -errno.
+ */
+int wgobfs_encode_skb(const struct wgobfs_cfg *cfg, struct sk_buff *skb);
+
+/* Reverses wgobfs_encode_skb() on a received UDP payload (skb->data is the
+ * start of the payload, skb->len its length). Returns 0 when skb now holds a
+ * WireGuard message, or -errno when the packet must be dropped (garbage,
+ * wrong key, STUN control traffic).
+ */
+int wgobfs_decode_skb(const struct wgobfs_cfg *cfg, struct sk_buff *skb);
+
+/* Writes a STUN Binding Request into @buf (at least 28 bytes), returns its
+ * length.
+ */
+int wgobfs_stun_binding_request(u8 *buf);
+
+/* Seconds between STUN Binding Requests on an active connection. */
+#define WGOBFS_STUN_INTERVAL_S 10
+
+#endif /* _WG_WGOBFS_H */
