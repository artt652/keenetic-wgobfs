+/* STUN masking: a Binding Request goes out before every handshake initiation
+ * and at least every WGOBFS_STUN_INTERVAL_S seconds while there is traffic,
+ * so the flow looks like a STUN session, as with the wg-obfuscator client.
+ */
+static void wgobfs_maybe_send_stun(struct wg_peer *peer, struct sk_buff *skb)
+{
+	struct wg_device *wg = peer->device;
+	struct wgobfs_cfg *cfg;
+	struct sk_buff *req;
+	bool stun, handshake;
+	u64 now = get_jiffies_64();
+
+	rcu_read_lock_bh();
+	cfg = rcu_dereference_bh(wg->wgobfs);
+	stun = cfg && cfg->masking == WGOBFS_MASKING_STUN;
+	rcu_read_unlock_bh();
+	if (!stun)
+		return;
+
+	handshake = skb->len >= 4 &&
+		    le32_to_cpu(((struct message_header *)skb->data)->type) ==
+			    MESSAGE_HANDSHAKE_INITIATION;
+	if (!handshake && time_before64(now, READ_ONCE(peer->wgobfs_last_stun) +
+					      WGOBFS_STUN_INTERVAL_S * HZ))
+		return;
+	WRITE_ONCE(peer->wgobfs_last_stun, now);
+
+	req = alloc_skb(SKB_HEADER_LEN + 32, GFP_ATOMIC);
+	if (unlikely(!req))
+		return;
+	skb_reserve(req, SKB_HEADER_LEN);
+	skb_set_inner_network_header(req, 0);
+	skb_put(req, wgobfs_stun_binding_request(req->data));
+	send_skb_to_peer(peer, req, 0, true);
+}
+
+int wg_socket_send_skb_to_peer(struct wg_peer *peer, struct sk_buff *skb, u8 ds)
+{
+	wgobfs_maybe_send_stun(peer, skb);
+	return send_skb_to_peer(peer, skb, ds, false);
+}
